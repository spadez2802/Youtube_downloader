   <string notr="true">/* Trạng thái bình thường: Nền trong suốt */
#FormHistoryItem {
  background-color: transparent;
  
  /* Chỉ áp dụng hiệu ứng chuyển đổi cho màu nền để tránh ảnh hưởng các thuộc tính khác */
  transition: background-color 0.2s ease-in-out; 
}

/* Trạng thái khi di chuột vào (hover): Nền sáng lên */
#FormHistoryItem:hover {
  /* Mã màu ví dụ: Trắng mờ. Bạn có thể đổi sang màu khác phù hợp với giao diện */
  background-color: rgba(255, 255, 255, 0.15); 
}


