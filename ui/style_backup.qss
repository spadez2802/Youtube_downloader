/* ============================================================
   SECTION 25: DOWNLOAD DIALOG (QDialog)
   Source: download_dialog_controller.py (line 38-70)
   ============================================================ */

QDialog {
    background-color: #2b2b2b;
    color: white;
}

QLabel {
    color: white;
    font-family: "Segoe UI", sans-serif;
    font-size: 11pt;
}

QTextEdit {
    background-color: black;
    color: white;
    border: 1px solid ACCENT_COLOR;
    border-radius: 10px;
    padding: 8px;
    font-family: "Segoe UI", sans-serif;
    font-size: 11pt;
}

QProgressBar {
    border: 2px solid ACCENT_COLOR;
    border-radius: 10px;
    background-color: #434343;
    color: white;
    text-align: center;
    font-weight: bold;
    height: 25px;
}

QProgressBar::chunk {
    background-color: ACCENT_COLOR;
    border-radius: 8px;
}


/* ============================================================
   SECTION 26: PAUSE/CANCEL BUTTONS (download dialog)
   Source: download_dialog.ui (#btnPauseContinue, #btnCancel)
   ============================================================ */

#btnPauseContinue,
#btnCancel {
    border: 2px solid;
    border-color: ACCENT_COLOR;
    border-radius: 20px;
    background-color: rgb(67, 67, 67);
    color: white;
    padding-left: 30px;
    font-family: "Segoe UI", Helvetica, Arial, sans-serif;
    font-size: 11pt;
    font-weight: bold;
}

#btnPauseContinue:hover,
#btnCancel:hover {
    border: 2px solid;
    border-color: ACCENT_COLOR;
    border-radius: 20px;
    background-color: ACCENT_COLOR;
    color: black;
}

#btnPauseContinue:disabled,
#btnCancel:disabled {
    border: 2px solid;
    border-color: rgb(136, 136, 136);
    border-radius: 20px;
    background-color: rgb(67, 67, 67);
    color: transparent;
}


