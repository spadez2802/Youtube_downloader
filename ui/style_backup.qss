    font-weight: bold;
}

#downloadAllBtn:hover {
    border: 2px solid;
    border-color: ACCENT_COLOR;
    border-radius: 20px;
    background-color: ACCENT_COLOR;
    color: black;
}


/* ============================================================
   SECTION 15: COMBOBOX — DOWNLOAD ALL FORMAT
   Source: newui.ui (#comboBoxDownloadAllOpt)
   ============================================================ */

#comboBoxDownloadAllOpt {
    border: 2px solid;
    border-color: ACCENT_COLOR;
    border-radius: 20px;
    background-color: rgb(67, 67, 67);
    color: white;
    padding-left: 80px;
    font-family: "Segoe UI", Helvetica, Arial, sans-serif;
    font-size: 11pt;
    font-weight: bold;
}

#comboBoxDownloadAllOpt:hover {
    border: 2px solid;
    border-color: ACCENT_COLOR;
