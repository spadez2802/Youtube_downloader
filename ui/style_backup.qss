/* ============================================================
   SECTION 28: MESSAGEBOX (confirm dialogs)
   Source: search_handler.py (line 481-503)
   ============================================================ */

QMessageBox {
    background-color: #2b2b2b;
}

QMessageBox QLabel {
    color: white;
    font-family: "Segoe UI", sans-serif;
    font-size: 11pt;
}

QMessageBox QPushButton {
    border: 2px solid ACCENT_COLOR;
    border-radius: 12px;
    background-color: rgb(67, 67, 67);
    color: white;
    padding: 4px 15px;
    font-family: "Segoe UI", sans-serif;
    font-weight: bold;
    min-width: 60px;
}

QMessageBox QPushButton:hover {
    background-color: ACCENT_COLOR;
    color: black;
}
