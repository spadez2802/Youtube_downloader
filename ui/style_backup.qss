/* ============================================================
   SECTION 16: CLEAR ALL / CHOOSE ALL BUTTONS (sidebar top)
   Source: newui.ui (#btnClearAll, #btnChooseAll)
   ============================================================ */

#btnClearAll,
#btnChooseAll {
    border: 2px solid;
    border-color: ACCENT_COLOR;
    border-radius: 10px;
    background-color: rgb(67, 67, 67);
    color: white;
    padding-left: 10px;
    font-family: "Segoe UI", Helvetica, Arial, sans-serif;
    font-size: 11pt;
    font-weight: bold;
}

#btnClearAll:hover,
#btnChooseAll:hover {
    border: 2px solid;
    border-color: ACCENT_COLOR;
    border-radius: 10px;
    background-color: ACCENT_COLOR;
    color: black;
}

#btnClearAll:disabled,
#btnChooseAll:disabled {
    border: 2px solid;
    border-color: rgb(136, 136, 136);
    border-radius: 10px;
    background-color: rgb(67, 67, 67);
    color: transparent;
}


/* ============================================================
   SECTION 17: MINI SIDEBAR TOGGLE BUTTON (◀ ▶)
   Source: ui_handler.py (line 81-93)
   ============================================================ */

#miniSideBarBtn {
    color: ACCENT_COLOR;
    font-size: 28px;
    font-weight: bold;
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
}

#miniSideBarBtn:hover {
    color: white;
}

#miniSideBarBtn:disabled {
    color: #555;
}


/* ============================================================
   SECTION 18: HISTORY AUTOCOMPLETE LIST
   Source: newui.ui (#listWidget)
   ============================================================ */

#listWidget {
    background-color: transparent;
    color: white;
    border-radius: 10px;
    border: 1px solid transparent;
    padding: 5px;
    outline: 0;
}

#listWidget::item {
    border-radius: 12px;
    margin: 2px 4px;
}

#listWidget::item:hover {
    background-color: rgb(67, 67, 67);
}

#listWidget::item:selected {
    background-color: rgb(80, 80, 80);
    color: ACCENT_COLOR;
}


/* ============================================================
   SECTION 19: MENU BAR
   Source: ui_handler.py (line 21-37)
   ============================================================ */

QMenuBar {
    background-color: transparent;
    border: none;
}

QMenuBar::item {
    font-size: 20px;
    color: white;
    background-color: transparent;
    margin: 0px 0px 0px 10px;
    padding: 2px 10px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: rgba(255, 255, 255, 0.2);
}


/* ============================================================
   SECTION 20: DROP-DOWN MENU (● ● ●)
   Source: ui_handler.py (line 41-70)
   ============================================================ */

QMenu {
    background-color: #2b2b2b;
    border: 1px solid #3e3e3e;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    font-size: 13px;
    font-family: "Segoe UI", Helvetica, Arial, sans-serif;
    color: white;
    padding: 6px 25px;
    border-radius: 4px;
}

QMenu::item:selected,
QMenu::item:checked {
    background-color: ACCENT_COLOR;
    color: black;
    font-weight: bold;
}

QMenu::indicator {
    image: none;
    width: 0px;
    height: 0px;
}

QMenu::separator {
    height: 1px;
    background-color: #3e3e3e;
    margin: 4px 0px;
}


