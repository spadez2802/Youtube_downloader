/*
==============================================================================
  STYLE BACKUP — TheDownloader App
  Extracted from: newui.ui, download_dialog.ui, mini.ui,
                  ui_handler.py, search_handler.py, download_dialog_controller.py
  
  Accent color (placeholder): ACCENT_COLOR = #1ED761
  Surface dark:               #2b2b2b
  Surface button:             #434343  (= rgb(67,67,67))
  Background:                 #000000
  Disabled border:            #888888  (= rgb(136,136,136))
  Text primary:               white
  Text on accent:             black
  Border secondary:           #3e3e3e
==============================================================================
*/


/* ============================================================
   SECTION 1: MAIN WINDOW & CENTRAL WIDGET
   Source: newui.ui (line 39-41, 78-81)
   ============================================================ */

QMainWindow {
    background-color: ACCENT_COLOR;
}

#centralwidget {
    background-color: black;
}


/* ============================================================
   SECTION 2: SIDEBAR PANEL (RIGHT)
   Source: newui.ui (line 1024-1027)
   ============================================================ */

#sideBarWidget {
    background-color: #2b2b2b;
}


/* ============================================================
   SECTION 3: SEARCH BOX CARD
   Source: newui.ui (widget #widget, #widget_2)
   ============================================================ */

#widget {
    border-radius: 25px;
    background: #2b2b2b;
}

#widget_2 {
    border: 2px solid transparent;
    border-radius: 25px;
    background-color: #2b2b2b;
}


/* ============================================================
   SECTION 4: ENTER WIDGET (Search input container)
   Source: newui.ui (#enterWidget)
   ============================================================ */

#enterWidget {
    border: 2px solid transparent;
    border-radius: 25px;
    background-color: black;
    color: white;
    padding: 5px 15px;
}

#enterWidget:hover {
    border: 2px solid transparent;
    border-radius: 25px;
    background-color: rgb(52, 52, 52);
    color: white;
    padding: 5px 15px;
}

#enterWidget:focus {
    border: 2px solid transparent;
    border-radius: 20px;
    background-color: rgb(29, 29, 29);
    color: white;
    padding: 5px 15px;
}


/* ============================================================
   SECTION 5: SEARCH INPUT (QLineEdit)
   Source: newui.ui (#enterPlace)
   ============================================================ */

#enterPlace {
    border: 2px solid transparent;
    border-radius: 20px;
    background-color: transparent;
    color: white;
    padding: 5px 15px;
}

#enterPlace:focus {
    border: 2px solid transparent;
    border-radius: 20px;
    background-color: transparent;
    color: white;
    padding: 5px 15px;
}


/* ============================================================
   SECTION 6: CLEAR BUTTON (✕)
   Source: ui_handler.py (line 103-106)
   ============================================================ */

#clearBtn {
    background: transparent;
    color: #888;
    font-size: 18px;
    font-weight: bold;
    border: none;
}

#clearBtn:hover {
    color: ACCENT_COLOR;
}


/* ============================================================
   SECTION 7: FIND BUTTON
   Source: newui.ui (#findBtn)
   ============================================================ */

#findBtn {
    border: 2px solid;
    border-color: ACCENT_COLOR;
    border-radius: 20px;
    background-color: rgb(67, 67, 67);
    color: white;
    font-family: "Segoe UI", Helvetica, Arial, sans-serif;
    font-size: 11pt;
    font-weight: bold;
}

#findBtn:hover {
    border: 2px solid;
    border-color: ACCENT_COLOR;
    border-radius: 20px;
    background-color: ACCENT_COLOR;
    color: black;
}


/* ============================================================
   SECTION 8: LINK NAME LABEL (video title display)
   Source: newui.ui (#linkName)
   ============================================================ */

#linkName {
    border: 2px solid transparent;
    border-radius: 20px;
    background-color: black;
    color: white;
    padding: 5px 15px;
}


/* ============================================================
   SECTION 9: VIDEO CONTENT WIDGET
   Source: newui.ui (#linkContentWidget)
   ============================================================ */

#linkContentWidget {
    border: 2px solid transparent;
    border-radius: 25px;
    background-color: rgb(0, 0, 0);
}


/* ============================================================
   SECTION 10: VIDEO IMAGE LABEL
   Source: newui.ui (#videoImg)
   ============================================================ */

#videoImg {
    border: 2px solid transparent;
    border-radius: 20px;
}


/* ============================================================
   SECTION 11: DOWNLOAD BUTTON (single video)
   Source: newui.ui (#downloadBtn)
   ============================================================ */

#downloadBtn {
    border: 2px solid;
    border-color: ACCENT_COLOR;
    border-radius: 20px;
    background-color: rgb(67, 67, 67);
    color: white;
    font-family: "Segoe UI", Helvetica, Arial, sans-serif;
    font-size: 11pt;
    font-weight: bold;
}

#downloadBtn:hover {
    border: 2px solid;
    border-color: ACCENT_COLOR;
    border-radius: 20px;
    background-color: ACCENT_COLOR;
    color: black;
}

#downloadBtn:disabled {
    border: 2px solid;
    border-color: rgb(136, 136, 136);
    border-radius: 20px;
    background-color: rgb(67, 67, 67);
    color: white;
}


/* ============================================================
   SECTION 12: COMBOBOX — FORMAT SELECTOR (main, MP3/MP4)
   Source: newui.ui (#comboBoxDownloadOption)
   ============================================================ */

#comboBoxDownloadOption {
    border: 2px solid;
    border-color: ACCENT_COLOR;
    border-radius: 20px;
    background-color: rgb(67, 67, 67);
    color: white;
    padding-left: 30px;
    font-family: "Segoe UI", Helvetica, Arial, sans-serif;
    font-size: 11pt;
    font-weight: bold;
}

#comboBoxDownloadOption:hover {
    border: 2px solid;
    border-color: ACCENT_COLOR;
    border-radius: 20px;
    background-color: ACCENT_COLOR;
    color: black;
}

#comboBoxDownloadOption::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
}

#comboBoxDownloadOption::down-arrow {
    image: url("ARROW_ICON_PATH");
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    width: 12px;
    height: 12px;
    margin-right: 10px;
}

#comboBoxDownloadOption:disabled {
    border: 2px solid;
    border-color: rgb(136, 136, 136);
    border-radius: 20px;
    background-color: rgb(67, 67, 67);
    color: white;
}


/* ============================================================
   SECTION 13: COMBOBOX — QUALITY SELECTOR
   Source: newui.ui + btn.css (#comboBoxDownloadQuality)
   ============================================================ */

#comboBoxDownloadQuality {
    border: 2px solid;
    border-color: ACCENT_COLOR;
    border-radius: 20px;
    background-color: rgb(67, 67, 67);
    color: white;
    padding-left: 30px;
    font-family: "Segoe UI", Helvetica, Arial, sans-serif;
    font-size: 11pt;
    font-weight: bold;
}

#comboBoxDownloadQuality:hover {
    border: 2px solid;
    border-color: ACCENT_COLOR;
    border-radius: 20px;
    background-color: ACCENT_COLOR;
    color: black;
}

#comboBoxDownloadQuality::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
}

#comboBoxDownloadQuality::down-arrow {
    image: url("ARROW_ICON_PATH");
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    width: 12px;
    height: 12px;
    margin-right: 10px;
}

#comboBoxDownloadQuality:disabled {
    border: 2px solid;
    border-color: rgb(136, 136, 136);
    border-radius: 20px;
    background-color: rgb(67, 67, 67);
    color: transparent;
}

#comboBoxDownloadQuality::down-arrow:disabled {
    image: none;
}


/* ============================================================
   SECTION 14: DOWNLOAD ALL BUTTON
   Source: newui.ui (#downloadAllBtn)
   ============================================================ */

#downloadAllBtn {
    border: 2px solid;
    border-color: ACCENT_COLOR;
    border-radius: 20px;
